# Copy this file to .env and fill in your key.
# Any OpenAI-compatible endpoint works; Groq is the default (free tier: https://console.groq.com/keys).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Model names change often. Run `python scripts/list_models.py` to see what your key can use.
LLM_MODEL_FAST=openai/gpt-oss-120b
LLM_MODEL_REPORT=openai/gpt-oss-120b

# Backup: Google Gemini free tier (https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL_FAST=gemini-2.5-flash
# LLM_MODEL_REPORT=gemini-2.5-flash

CORS_ORIGINS=http://localhost:5173

# Access code required to sign up as a recruiter (leave empty to disable recruiter sign-up).
RECRUITER_SIGNUP_CODE=change-me-recruiter-code
# How long a login stays valid.
SESSION_DAYS=7
